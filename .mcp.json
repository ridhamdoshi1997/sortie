{
  "mcpServers": {
    "gemini-mcp-tool": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "gemini-mcp-tool"
      ],
      "env": {
        "GEMINI_MCP_BACKEND": "gemini",
        "GEMINI_MODEL": "gemini-3.5-flash"
      }
    },
    "perplexity-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@perplexity-ai/mcp-server"
      ],
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}"
      }
    }
  }
}