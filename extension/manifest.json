{
  "manifest_version": 3,
  "name": "Sortie — Save to Tracker",
  "version": "1.5.0",
  "description": "Save job postings from LinkedIn, Indeed, and 8 more job boards straight into your Sortie tracker.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.indeed.com/*",
    "https://www.simplyhired.com/*",
    "https://www.dice.com/*",
    "https://www.careerbuilder.com/*",
    "https://remoteok.com/*",
    "https://www.monster.com/*",
    "https://weworkremotely.com/*",
    "https://builtin.com/*",
    "https://www.ziprecruiter.com/*",
    "https://jobpilot-experiment.vercel.app/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://www.indeed.com/*",
        "https://www.simplyhired.com/*",
        "https://www.dice.com/*",
        "https://www.careerbuilder.com/*",
        "https://remoteok.com/*",
        "https://www.monster.com/*",
        "https://weworkremotely.com/*",
        "https://builtin.com/*",
        "https://www.ziprecruiter.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
