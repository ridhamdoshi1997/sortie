#!/bin/sh
# Tracked git hook (see context/SETUP.md) — same dependency-drift check as
# post-merge, but fires on `git checkout`/`git switch` between branches
# (e.g. an agent switching to a branch another agent/machine pushed to).
# $1=previous HEAD, $2=new HEAD, $3=1 if a real branch checkout (not a
# single-file checkout) — only act on real branch switches.

PREV_HEAD=$1
NEW_HEAD=$2
IS_BRANCH_CHECKOUT=$3

if [ "$IS_BRANCH_CHECKOUT" != "1" ]; then
  exit 0
fi

CHANGED=$(git diff --name-only "$PREV_HEAD" "$NEW_HEAD" 2>/dev/null | grep -E "^(package\.json|package-lock\.json)$" || true)

if [ -n "$CHANGED" ]; then
  echo ""
  echo "  ⚠ package.json/package-lock.json differs on this branch."
  echo "    Run: npm install"
  echo ""
fi
